---
import Logo from '../components/Logo.astro';
import Layout from '../layouts/Layout.astro';
import { formattedDate } from '../utils/formattedDate';
import SpotlightBackground from '../components/SpotlightBackground.astro';

const date = formattedDate({ withTime: true })
---

<Layout>
	<SpotlightBackground 
		duration={7}
		xOffset={100}
		translateY={-350}
		width={560}
		height={1380}
		smallWidth={240}
	/>
	<main class="min-h-dvh flex flex-col p-5 relative">
		<div class="border-neutral-50 border-b">
			<p class="text-center">Alias <b>festivae.mp</b></p>
		</div>
		<div class="flex-1 flex justify-center items-center">
			<div class="flex flex-col gap-10">
				<header>
					<Logo class="w-full h-auto sm:max-w-sm" />
					<h1 class="sr-only">FestivAE</h1>
				</header>
				<p class="text-center text-lg">{date}</p>
			</div>
		</div>
		<footer class="flex justify-between flex-col md:flex-row-reverse">
			<div>Direccion</div>
			<div>Redes</div>
		</footer>
	</main>
</Layout>
