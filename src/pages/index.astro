---
import { Image } from "astro:assets";

import bg from "../assets/bg.png";
import GlowIcon from "../components/GlowIcon.astro";
import GlowText from "../components/GlowText.astro";
import Link from "../components/Link.astro";
import Logo from "../components/Logo.astro";
import SpotlightBackground from "../components/SpotlightBackground/SpotlightBackground.astro";
import CopyText from "../components/svelte/CopyText.svelte";
import Layout from "../layouts/Layout.astro";
import { formattedDate } from "../utils/formattedDate";

const date = formattedDate({ withTime: true });

interface SocialMediaLink {
  href: string;
  icon: string;
  name: string;
  title?: string;
}

const socialMediaLinks: Array<SocialMediaLink> = [
  {
    name: "Youtube",
    href: "https://www.youtube.com/@festivaaee",
    icon: "mdi:youtube",
  },
  {
    name: "Instagram",
    href: "https://www.instagram.com/festiv.ae/",
    icon: "mdi:instagram",
  },
];
---

<Layout>
  <Image
    class="absolute inset-0 object-cover h-dvh bg-blend-multiply pointer-events-none"
    src={bg}
    alt=""
  />
  <SpotlightBackground
    duration={7}
    xOffset={100}
    translateY={-350}
    width={560}
    height={1380}
    smallWidth={240}
  />
  <main class="min-h-dvh flex flex-col p-5 relative container mx-auto">
    <CopyText
      client:load
      class="p-4 rounded-2xl self-center md:text-xl bg-fae-green text-neutral-900 drop-shadow-centered drop-shadow-transparent hover:drop-shadow-fae-green text-center hover:scale-105 transition active:scale-100 will-change-transform"
      copy="festivae.mp"
    >
      Hace tus aportes al alias festivae.mp
    </CopyText>
    <div class="flex-1 flex justify-center items-center">
      <div class="flex flex-col gap-10">
        <header>
          <Logo class="w-full h-auto sm:max-w-md" />
          <h1 class="sr-only">FestivAE</h1>
        </header>
        <GlowText class="text-center text-2xl">{date}</GlowText>
      </div>
    </div>
    <footer
      class="flex items-center justify-between flex-col md:flex-row-reverse"
    >
      <GlowText>
        <Link
          class="flex items-center gap-1"
          external
          href="https://www.google.com/maps/place/UNTREF+Sede+Lynch/@-34.5988708,-58.5278781,19z/data=!4m6!3m5!1s0x95bcb7bf5c7fe83b:0x5694f47b93932ceb!8m2!3d-34.5984469!4d-58.5277789!16s%2Fg%2F11b8jctkgn?entry=ttu"
        >
          <GlowIcon class="size-6" name="mdi:location-on-outline" />
          Dirección: Dr. Alfredo E. Springolo 351
        </Link>
      </GlowText>
      <div>
        <h4 class="sr-only">Redes</h4>
        <ul class="flex gap-2 items-center">
          {
            socialMediaLinks.map((link) => (
              <li class="flex gap-3 md:gap-4 items-center">
                <Link
                  class="size-8 md:size-12 flex items-center justify-center"
                  external
                  href={link.href}
                >
                  <GlowIcon
                    class="size-6 md:size-8"
                    description={link.name}
                    name={link.icon}
                  />
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
  </main>
</Layout>
