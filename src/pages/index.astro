---
import GlowIcon from "../components/GlowIcon.astro";
import GlowText from "../components/GlowText.astro";
import Link from "../components/Link.astro";
import Logo from "../components/Logo.astro";
import CopyText from "../components/svelte/CopyText.svelte";
import Layout from "../layouts/Layout.astro";
import { formattedDate } from "../utils/formattedDate";

const date = formattedDate({ withTime: true });

interface SocialMediaLink {
    href: string;
    icon: string;
    name: string;
    title?: string;
}

const socialMediaLinks: Array<SocialMediaLink> = [
    {
        name: "Youtube",
        href: "https://www.youtube.com/@festivaaee",
        icon: "mdi:youtube",
    },
    {
        name: "Instagram",
        href: "https://www.instagram.com/festiv.ae/",
        icon: "mdi:instagram",
    },
];
---

<Layout>
    <main
        class="min-h-dvh flex flex-col p-5 relative container mx-auto starting:opacity-0 motion-safe:starting:blur-sm transition z-10"
    >
        <CopyText
            client:load
            class="p-4 rounded-2xl self-center md:text-xl bg-fae-orange text-neutral-950 drop-shadow-centered drop-shadow-transparent hover:drop-shadow-black text-center hover:scale-105 transition active:scale-100 will-change-transform"
            copy="festivae.mp"
        >
            <span> Hace tus aportes al alias festivae.mp </span>
        </CopyText>
        <div class="flex-1 flex justify-center items-center">
            <div class="flex flex-col gap-10">
                <header class="flex flex-col items-center">
                    <Logo class="w-full h-auto sm:max-w-md -mb-20" />
                    <GlowText
                        as="h1"
                        class="font-body text-6xl sm:text-8xl tracking-widest text-center drop-shadow-centered-lg drop-shadow-neutral-950"
                    >
                        FESTIVAE
                    </GlowText>
                </header>
                <GlowText class="text-center text-2xl sm:text-3xl">
                    {date}
                </GlowText>
            </div>
        </div>
        <footer
            class="flex items-center justify-between flex-col md:flex-row-reverse"
        >
            <GlowText>
                <Link
                    class="flex items-center gap-1 text-2xl"
                    external
                    href="https://www.google.com/maps/place/UNTREF+Sede+Lynch/@-34.5988708,-58.5278781,19z/data=!4m6!3m5!1s0x95bcb7bf5c7fe83b:0x5694f47b93932ceb!8m2!3d-34.5984469!4d-58.5277789!16s%2Fg%2F11b8jctkgn?entry=ttu"
                >
                    <GlowIcon class="size-6" name="mdi:location-on-outline" />
                    Dirección: Dr. Alfredo E. Springolo 351
                </Link>
            </GlowText>
            <div>
                <h4 class="sr-only">Redes</h4>
                <ul class="flex gap-2 items-center">
                    {
                        socialMediaLinks.map((link) => (
                            <li class="flex gap-3 md:gap-4 items-center">
                                <Link
                                    class="size-8 md:size-12 flex items-center justify-center"
                                    external
                                    href={link.href}
                                >
                                    <GlowIcon
                                        class="size-6 md:size-8"
                                        description={link.name}
                                        name={link.icon}
                                    />
                                </Link>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </footer>
    </main>
</Layout>
