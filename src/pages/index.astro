---
import { getImage } from "astro:assets";
import sillas from "../assets/sillas-noise.png";
import GlowTag from "../components/GlowTag.astro";
import Logo from "../components/Logo.astro";
import InteractiveBackground from "../components/svelte/shaders/InteractiveBackground.svelte";
import Layout from "../layouts/Layout.astro";
import {
  DATE_SHORT,
  FULL_DATE_WITH_TIME_ACCESSIBLE,
  TIME_ABBR,
} from "../utils/formattedDate";
import FadeImage from "../components/FadeImage.astro";
// import Countdown from "../components/svelte/Countdown.svelte";
import Link from "../components/Link.astro";

const { src: sillasWebp } = await getImage({
  src: sillas,
  position: "center",
  fit: "contain",
  format: "webp",
});
---

<Layout class="overflow-x-hidden bg-neutral-950 text-neutral-100">
  <main
    class="relative z-10 container mx-auto flex size-full max-w-3xl flex-col items-center justify-between gap-10 p-5 drop-shadow-centered-lg drop-shadow-neutral-950 transition starting:opacity-0 motion-safe:starting:blur-sm"
  >
    <!-- <aside
      class="sticky top-4 flex w-full items-center justify-center"
      id="aportes"
    >
      <CopyText
        client:load
        afterCopy="¡Se copió el alias al portapapeles!"
        inline
        class="transform-gpu rounded-2xl border border-white/5 bg-neutral-950 p-4 text-2xl uppercase shadow-sm inset-shadow-sm shadow-fae-orange/50 inset-shadow-neutral-50/50 transition hover:scale-105 focus:scale-100 active:scale-95"
        copy="festivae.mp"
      >
        <span> Hace tus aportes al alias festivae.mp </span>
      </CopyText>
    </aside> -->
    <article
      id="content"
      class="flex w-full flex-col items-center justify-center gap-10"
    >
      <aside
        class="flex w-full items-center justify-between text-2xl uppercase motion-safe:font-body-alt md:text-3xl"
      >
        <GlowTag aria-hidden="true">
          {DATE_SHORT}
        </GlowTag>
        <GlowTag aria-hidden="true">
          {TIME_ABBR}
        </GlowTag>
        <p class="sr-only">{FULL_DATE_WITH_TIME_ACCESSIBLE}</p>
      </aside>
      <header
        class="w-full rounded-2xl border border-white/5 bg-neutral-950 p-4 shadow-md inset-shadow-sm shadow-fae-dark-blue inset-shadow-neutral-50/50"
      >
        <div
          class="rounded-2xl border border-white/5 bg-neutral-950 p-4 inset-shadow-sm inset-shadow-neutral-50/50 sm:p-8"
        >
          <h1
            class="bg-conic from-fae-yellow from-10% via-fae-orange to-fae-yellow to-90% bg-size-[1ch] bg-clip-text text-5xl font-bold text-transparent uppercase text-shadow-2xs text-shadow-neutral-950/5 motion-safe:font-headings lg:text-8xl"
          >
            FestivAE{" "}
            <span aria-hidden="true">IX</span>
            <span class="sr-only">
              (festival de Artes Electrónicas), novena edición
            </span>
          </h1>
          <h2
            class="bg-conic from-fae-yellow from-10% via-fae-orange to-fae-yellow to-90% bg-size-[1ch] bg-clip-text text-2xl font-bold text-transparent uppercase text-shadow-2xs text-shadow-neutral-950/5 motion-safe:font-body-alt lg:text-3xl"
          >
            En defensa de la universidad pública
          </h2>
        </div>
      </header>
      <!-- <section
        id="countdown"
        aria-hidden="true"
        class="w-full drop-shadow-centered-xl drop-shadow-fae-purple/20"
      >
        <GlowTag
          as="div"
          class="flex w-full items-center justify-center drop-shadow-neutral-100"
        >
          <Countdown client:only>
            <div class="flex-col">
              <Logo class="size-20 pt-3" />
            </div>
          </Countdown>
        </GlowTag>
      </section> -->
      <section id="lineup">
        <header class="sr-only">
          <h3>Lineup del festival:</h3>
          <ul
            class="xs:text-3xl flex flex-wrap items-center justify-center gap-4 p-4 text-2xl uppercase motion-safe:font-body-alt lg:max-w-lg lg:text-4xl"
          >
            <li>Pequeño Bambi</li>
            <li>Fuego Fatuo</li>
            <li>Elandro</li>
            <li>Jennitza</li>
            <li>Ana Vojnov</li>
            <li>Pipaconpan</li>
          </ul>
        </header>
        <GlowTag
          aria-hidden="true"
          as="div"
          class="flex max-w-lg flex-wrap items-center justify-center gap-4 p-4 text-2xl uppercase drop-shadow-neutral-100 motion-safe:font-body-alt md:text-3xl lg:text-4xl"
        >
          <p>
            <Link href="https://www.instagram.com/bambipunky/" external>
              Pequeño Bambi
            </Link>
          </p>
          <p>
            <Link href="https://www.instagram.com/_fuegofatuo/" external>
              Fuego Fatuo
            </Link> — <Link
              href="https://www.instagram.com/elandro.b/"
              external
            >
              Elandro
            </Link>
          </p>
          <p>
            <Link href="https://www.instagram.com/jennitza.r/" external>
              Jennitza
            </Link> — <Link
              href="https://www.instagram.com/ana.vojnov/"
              external
            >
              Ana Vojnov
            </Link>
          </p>
          <p>
            <Link href="https://www.instagram.com/pipaconpan/" external>
              Pipaconpan
            </Link>
          </p>
        </GlowTag>
      </section>
      <section
        id="radio"
        class="xs:text-3xl text-2xl uppercase motion-safe:font-body-alt max-sm:text-center lg:text-4xl"
      >
        <header>
          <h3>
            <GlowTag class="drop-shadow-neutral-100" as="span">
              Radio <span aria-hidden="true">{" "}X{" "}</span>
              <span class="sr-only"> por </span>
            </GlowTag>
            <GlowTag
              as="span"
              class="drop-shadow-fae-blue text-shadow-fae-blue!"
            >
              investigaciones del futuro
            </GlowTag>
          </h3>
        </header>
      </section>
      <section
        id="obras"
        class="text-3xl drop-shadow-centered-lg drop-shadow-neutral-950 motion-safe:font-body-alt lg:text-4xl"
      >
        <header>
          <GlowTag as="h3" class="text-neutral-400 drop-shadow-neutral-950">
            <span class="sr-only">
              Presentando también: obras, instalaciones y performances
            </span>
            <span aria-hidden="true">
              + obras + instalaciones + performances
            </span>
          </GlowTag>
        </header>
      </section>
      <footer
        class="flex w-full items-center justify-around max-md:flex-col-reverse"
      >
        <GlowTag as="div" class="drop-shadow-neutral-100">
          <Logo class="size-44 pt-8" />
        </GlowTag>
        <GlowTag
          class="text-center text-2xl drop-shadow-neutral-100 md:text-4xl"
        >
          <Link
            external
            href="https://www.google.com/maps/place/UNTREF+Sede+Lynch/@-34.5988708,-58.5278781,19z/data=!4m6!3m5!1s0x95bcb7bf5c7fe83b:0x5694f47b93932ceb!8m2!3d-34.5984469!4d-58.5277789!16s%2Fg%2F11b8jctkgn?entry=ttu"
          >
            UNTREF — Villa Lynch <br /> Dr. Alfredo E. Springolo 351
          </Link>
        </GlowTag>
      </footer>
    </article>
  </main>
  <InteractiveBackground fallbackImageSrc={sillasWebp} client:optimal />
  <FadeImage
    class="fixed inset-0 size-full object-cover"
    fit="cover"
    src={sillas}
    alt="Sillas apiladas"
    layout="constrained"
    optimal={false}
  />
</Layout>
