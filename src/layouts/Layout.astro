---
import '../styles/global.css'
import { DATE_UTC } from '../lib/constants'
import { Font } from 'astro:assets'

const dateString = DATE_UTC.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'utc' })
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>FestivAE - {dateString}</title>
		<Font cssVariable="--font-roboto-condensed" />
		<Font cssVariable="--font-turret-road" />
	</head>
	<body class="bg-neutral-50 text-neutral-950 dark:bg-neutral-950 dark:text-neutral-50">
		<slot />
	</body>
</html>

