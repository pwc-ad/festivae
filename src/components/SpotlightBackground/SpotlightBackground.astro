---
// Based on https://ui.aceternity.com/components/spotlight-new

export interface Props {
  gradientFirst?: string;
  gradientSecond?: string;
  gradientThird?: string;
  translateY?: number;
  width?: number;
  height?: number;
  smallWidth?: number;
  duration?: number;
  xOffset?: number;
}

const {
  gradientFirst = "radial-gradient(68.54% 68.72% at 55.02% 31.46%, var(--tw-gradient-from) 0, var(--tw-gradient-to) 50%, transparent 80%)",
  gradientSecond = "radial-gradient(50% 50% at 50% 50%, var(--tw-gradient-from) 0, var(--tw-gradient-via) 80%, transparent 100%)",
  gradientThird = "radial-gradient(50% 50% at 50% 50%, var(--tw-gradient-from) 0, var(--tw-gradient-via) 80%, transparent 100%)",
  translateY = -350,
  width = 560,
  height = 1380,
  smallWidth = 240,
  duration = 7,
  xOffset = 100,
} = Astro.props;

const durationSeconds = duration;
---

<div class="pointer-events-none fixed inset-0 h-full w-full animate-fade-in">
  <!-- Left side spotlight -->
  <div
    class="absolute top-0 left-0 w-screen h-screen z-40 pointer-events-none animate-slide-left"
    style={`animation-duration: ${durationSeconds}s;`}
  >
    <div
      class="absolute top-0 left-0 from-fae-purple/5  to-fae-purple/5"
      style={`
        transform: translateY(${translateY}px) rotate(-45deg);
        background: ${gradientFirst};
        width: ${width}px;
        height: ${height}px;
      `}
    />

    <div
      class="absolute top-0 left-0 origin-top-left from-fae-purple/5  to-fae-green/5"
      style={`
        transform: rotate(-45deg) translate(5%, -50%);
        background: ${gradientSecond};
        width: ${smallWidth}px;
        height: ${height}px;
      `}
    />

    <div
      class="absolute top-0 left-0 origin-top-left from-fae-purple/5  to-fae-green/5"
      style={`
        transform: rotate(-45deg) translate(-180%, -70%);
        background: ${gradientThird};
        width: ${smallWidth}px;
        height: ${height}px;
      `}
    />

  </div>

  <!-- Right side spotlight -->
  <div
    class="absolute top-0 right-0 w-screen h-screen z-40 pointer-events-none animate-slide-right"
    style={`animation-duration: ${durationSeconds}s;`}
  >
    <div
      class="absolute top-0 right-0 from-fae-purple/5  to-fae-purple/5"
      style={`
        transform: translateY(${translateY}px) rotate(45deg);
        background: ${gradientFirst};
        width: ${width}px;
        height: ${height}px;
      `}
    >
    </div>
    <div
      class="absolute top-0 right-0 origin-top-right from-fae-purple/5  to-fae-green/5"
      style={`
        transform: rotate(45deg) translate(-5%, -50%);
        background: ${gradientSecond};
        width: ${smallWidth}px;
        height: ${height}px;
      `}
    >
    </div>
    <div
      class="absolute top-0 right-0 origin-top-right from-fae-purple/5  to-fae-green/5"
      style={`
        transform: rotate(45deg) translate(180%, -70%);
        background: ${gradientThird};
        width: ${smallWidth}px;
        height: ${height}px;
      `}
    >
    </div>
  </div>
</div>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slide-left {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(100px);
    }
  }

  @keyframes slide-right {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(-100px);
    }
  }

  .animate-fade-in {
    animation: fade-in 1.5s ease-out forwards;
  }

  .animate-slide-left {
    animation: slide-left ease-in-out infinite reverse;
  }

  .animate-slide-right {
    animation: slide-right ease-in-out infinite reverse;
  }
</style>
