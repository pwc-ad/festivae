---
import type { HTMLAttributes } from "astro/types";
import { cleanAstroClasslist } from "../lib/utils/astro";

type Props = HTMLAttributes<"ul">;

const { "class:list": classList, ...props } = cleanAstroClasslist(Astro.props);
---

<ul
  {...props}
  class:list={[classList, "list-outside list-disc space-y-3 pl-8"]}
>
  <slot />
</ul>
