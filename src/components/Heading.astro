---
import type { HTMLTag, PolymorphicAttributes } from "astro/types";
import { cleanAstroClasslist } from "../lib/utils/astro";

type Props<Tag extends ValidTags> = PolymorphicAttributes<{
  as: Tag;
}> & { id: string };
type ValidTags = Extract<HTMLTag, `h${1 | 2 | 3}`>;

const headingVariants = {
  h1: "font-bold text-3xl md:text-5xl",
  h2: "uppercase font-bold text-2xl md:text-4xl",
  h3: "font-bold text-xl md:text-3xl",
} as const satisfies Record<ValidTags, string>;

const {
  as: Tag = "h1",
  id,
  "class:list": classList,
  ...props
} = cleanAstroClasslist(Astro.props as Props<ValidTags>);
---

<a class:list={["inline-block w-full", classList]} href={`#${id}`}>
  <Tag class:list={["underline", headingVariants[Tag]]} id={id} {...props}>
    <slot />
  </Tag>
</a>
