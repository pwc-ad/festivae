---
import type { HTMLTag, PolymorphicAttributes } from "astro/types";
import { cleanAstroClasslist } from "../lib/utils/astro";

type Props<Tag extends ValidTags> = PolymorphicAttributes<{
  as: Tag;
}> & { id: string };
type ValidTags = Extract<HTMLTag, `h${1 | 2}`>;

const headingVariants = {
  h1: "font-bold text-2xl md:text-5xl underline",
  h2: "uppercase underline font-bold text-xl md:text-4xl",
} as const satisfies Record<ValidTags, string>;

const {
  as: Tag = "h1",
  id,
  "class:list": classList,
  ...props
} = cleanAstroClasslist(Astro.props as Props<ValidTags>);
---

<a href={`#${id}`}>
  <Tag class:list={[classList, headingVariants[Tag]]} id={id} {...props}>
    <slot />
  </Tag>
</a>
