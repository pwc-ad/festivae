---
import { Icon } from "astro-icon/components";

import { navItemClass } from "./navStyles";

import Link from "../Link.astro";
import type { HTMLAttributes } from "astro/types";
import NavHint from "./NavHint.astro";

const { routePattern: pathname } = Astro;

interface Props extends HTMLAttributes<"a"> {
  id?: string;
  href: string;
  icon: string;
  name: string;
  smallIcon?: true;
}

const { href, icon, id = href, name, smallIcon, ...props } = Astro.props;

const Tag = href ? Link : "span";

const tagProps = href
  ? {
      id: pathname === href ? "navigation" : undefined,
      href,
      interestfor: id,
      external: !href.startsWith("/"),
    }
  : { href: undefined as unknown as string };
---

<Tag
  class:list={[
    "font-bold underline",
    navItemClass,
    pathname === href
      ? "text-neutral-100 drop-shadow-fae-purple"
      : "drop-shadow-transparent",
  ]}
  {...tagProps}
>
  <Icon
    class:list={["size-8", smallIcon && "sm:hidden"]}
    name={icon}
    aria-hidden="true"
  />
  <span class={smallIcon ? "max-sm:sr-only" : "sr-only"}>{name}</span>
</Tag>

<NavHint id={id}>{name}</NavHint>
