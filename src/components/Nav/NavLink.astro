---
import { Icon } from "astro-icon/components";

import Link from "../Link.astro";
import { navItemClass } from "./navStyles";

const { routePattern: pathname } = Astro;

interface Props {
  href: string;
  icon?: string;
  name: string;
}

const { href, icon, name } = Astro.props;
---

<li>
  <Link
    class:list={[
      "underline",
      navItemClass,
      pathname === href
        ? "font-bold text-neutral-100 drop-shadow-fae-purple"
        : "drop-shadow-transparent",
    ]}
    id={pathname === href ? "navigation" : undefined}
    href={href}
    external={!href.startsWith("/")}
  >
    {
      icon ? (
        <>
          <Icon class="size-8" name={icon} aria-hidden="true" />
          <span class="sr-only">{name}</span>
        </>
      ) : (
        name
      )
    }
  </Link>
</li>
