---
import type { ComponentProps } from "astro/types";

import NavLink from "./NavLink.astro";
import NavCopyBankAlias from "./NavCopyBankAlias.astro";

type Route = ComponentProps<typeof NavLink>;

const ROUTES = [
  {
    href: "/",
    name: "Inicio",
    icon: "mdi:house",
    smallIcon: true,
  },
  {
    href: "/codigo-de-convivencia",
    name: "Convivencia",
    icon: "mdi:file-document-alert",
    smallIcon: true,
  },
  {
    href: "/mapa",
    name: "Mapa",
    icon: "mdi:map-search",
    smallIcon: true,
  },
  {
    href: "/cronograma",
    name: "Cronograma",
    icon: "mdi:calendar-clock",
    smallIcon: true,
  },
] as const satisfies Array<Route>;

const SOCIALS = [
  {
    href: "https://www.youtube.com/@festivaaee",
    icon: "mdi:youtube",
    name: "YouTube",
  },
  {
    href: "https://www.instagram.com/festiv.ae/",
    icon: "mdi:instagram",
    name: "Instagram",
  },
] as const satisfies Array<Route>;
---

<footer class="h-16 w-full sm:h-20">
  <nav
    class="fixed bottom-0 z-20 flex h-16 w-full items-center justify-center sm:bottom-4"
  >
    <ul
      class="flex size-full items-center justify-around bg-neutral-900 p-4 text-xl text-neutral-400 uppercase inset-shadow-xs inset-shadow-neutral-50/50 sm:max-w-xl sm:justify-between sm:rounded-xl sm:border sm:border-white/5 sm:shadow-lg sm:inset-shadow-sm"
    >
      {
        ROUTES.map((route) => (
          <li>
            <NavLink {...route} />
          </li>
        ))
      }
      <li>
        <NavCopyBankAlias />
      </li>
      {
        SOCIALS.map((route) => (
          <li>
            <NavLink {...route} />
          </li>
        ))
      }
    </ul>
  </nav>
</footer>
