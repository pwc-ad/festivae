---
import type { ComponentProps } from "astro/types";

import CopyBankAlias from "../svelte/CopyBankAlias.svelte";

import NavLink from "./NavLink.astro";

type Route = ComponentProps<typeof NavLink>;

const ROUTES = [
  {
    href: "/",
    name: "Inicio",
  },
  {
    href: "/codigo-de-convivencia",
    name: "Convivencia",
  },
] as const satisfies Array<Route>;

const SOCIALS = [
  {
    href: "https://www.youtube.com/@festivaaee",
    icon: "mdi:youtube",
    name: "Youtube",
  },
  {
    href: "https://www.instagram.com/festiv.ae/",
    icon: "mdi:instagram",
    name: "Instagram",
  },
] as const satisfies Array<Route>;
---

<footer class="h-16 w-full md:h-20">
  <nav
    class="fixed bottom-0 z-20 flex h-16 w-full items-center justify-center md:bottom-4"
  >
    <ul
      class="flex size-full items-center justify-between bg-neutral-900 p-4 text-xl text-neutral-300 uppercase inset-shadow-sm inset-shadow-neutral-50/50 md:max-w-sm md:rounded-xl md:border md:border-white/5 md:shadow-lg"
    >
      {ROUTES.map((route) => <NavLink {...route} />)}
      <li>
        <CopyBankAlias
          client:load
          class="animate-tada text-neutral-50 uppercase drop-shadow-centered drop-shadow-fae-green transition animate-duration-1000 animate-iteration-count-4 hover:animate-none focus:animate-none active:scale-90 motion-reduce:animate-none"
        />
      </li>
      {SOCIALS.map((route) => <NavLink {...route} />)}
    </ul>
  </nav>
</footer>
