---
import type { ComponentProps } from "astro/types";

import CopyText from "../svelte/CopyText.svelte";

import NavLink from "./NavLink.astro";
import { navItemClass } from "./navStyles";

type Route = ComponentProps<typeof NavLink>;

const ROUTES = [
  {
    href: "/",
    name: "Inicio",
  },
  {
    href: "/codigo-de-convivencia",
    name: "Convivencia",
  },
] as const satisfies Array<Route>;

const SOCIALS = [
  {
    href: "https://www.youtube.com/@festivaaee",
    icon: "mdi:youtube",
    name: "Youtube",
  },
  {
    href: "https://www.instagram.com/festiv.ae/",
    icon: "mdi:instagram",
    name: "Instagram",
  },
] as const satisfies Array<Route>;
---

<footer class="h-16 w-full md:h-20">
  <nav
    class="fixed bottom-0 z-20 flex h-16 w-full items-center justify-center md:bottom-4"
  >
    <ul
      class="flex size-full items-center justify-between bg-neutral-900 p-4 text-xl text-neutral-300 uppercase inset-shadow-sm inset-shadow-white/50 md:max-w-sm md:rounded-xl md:border md:border-white/5 md:shadow-lg"
    >
      {ROUTES.map((route) => <NavLink {...route} />)}
      <li>
        <CopyText
          client:load
          afterCopy="Se copió nuestro alias (festivae.mp) al portapapeles, ¡Hacenos tu aporte!"
          copy="festivae.mp"
          class={`${navItemClass} animate-tada animate-duration-1000 animate-iteration-count-thrice hover:animate-none focus:animate-none active:scale-90 transition motion-reduce:animate-none uppercase`}
        >
          Aportes
        </CopyText>
      </li>
      {SOCIALS.map((route) => <NavLink {...route} />)}
    </ul>
  </nav>
</footer>
