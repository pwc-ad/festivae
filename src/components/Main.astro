---
import type { HTMLAttributes } from "astro/types";
import { cleanAstroClasslist } from "../lib/utils/astro";
import GlowTag from "./GlowTag.astro";
import Logo from "./Logo.astro";

type Props = HTMLAttributes<"main">;

const { "class:list": classList, ...props } = cleanAstroClasslist(Astro.props);
---

<main
  class:list={[
    "container mx-auto flex size-full max-w-3xl flex-col px-4 py-6 drop-shadow-centered-lg drop-shadow-neutral-950 motion-safe:transition md:py-10 starting:opacity-0",
    classList,
  ]}
>
  <slot />
  <GlowTag
    as="footer"
    class="flex w-full flex-col items-center justify-center drop-shadow-neutral-50"
  >
    <Logo class="size-44 pt-8" />
    <p class="text-4xl uppercase">FestivAE</p>
  </GlowTag>
</main>
