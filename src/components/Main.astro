---
import type { HTMLAttributes } from "astro/types";
import { cleanAstroClasslist } from "../lib/utils/astro";

type Props = HTMLAttributes<"main">;

const { "class:list": classList, ...props } = cleanAstroClasslist(Astro.props);
---

<main
  class:list={[
    "container mx-auto flex size-full max-w-3xl px-4 py-6 drop-shadow-centered-lg drop-shadow-neutral-950 motion-safe:transition md:py-10 starting:opacity-0",
    classList,
  ]}
>
  <slot />
</main>
