---
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof Image> & {
    blur?: `motion-safe:${`blur-${"xs" | "sm" | "md" | "lg" | "xl" | `${number}xl` | `[${number}${string}]`}`}`;
};

const {
    blur = "motion-safe:blur-sm",
    class: className,
    ...props
} = Astro.props;
---

<Image
    class:list={[blur, className, "opacity-0 transition"]}
    data-blur={blur}
    {...props}
/>

<script>
    function handleLoad(target: HTMLImageElement) {
        target.classList.remove("opacity-0");
        target.classList.remove(target.dataset.blur!);
    }

    Array.from(document.getElementsByTagName("img")).forEach((image) => {
        if (image.complete) {
            handleLoad(image);
            return;
        }

        image.onload = () => handleLoad(image);
    });
</script>
