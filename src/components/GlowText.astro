---
import type { HTMLTag, Polymorphic } from "astro/types";
import { cleanAstroClasslist } from "../lib/utils/astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }>;

const { as: Tag = "p", ...props } = cleanAstroClasslist(Astro.props);
---

<Tag class="text-shadow-centered text-shadow-fae-purple" {...props}>
    <slot />
</Tag>
